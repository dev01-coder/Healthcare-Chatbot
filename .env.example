# ============================================
# MediAssist - Environment Config
# ============================================

# ── CHOOSE YOUR FREE LLM PROVIDER ──────────
# Options: groq | gemini | ollama | anthropic
LLM_PROVIDER=groq

# ── GROQ (FREE - Recommended) ───────────────
# Sign up FREE at: https://console.groq.com
# Free tier: 14,400 requests/day
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ── GOOGLE GEMINI (FREE) ────────────────────
# Sign up FREE at: https://aistudio.google.com/apikey
# Free tier: 1,000,000 tokens/day
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ── OLLAMA (100% LOCAL - No API Key) ────────
# Download from: https://ollama.com
# Then run: ollama pull llama3.2
# No internet needed after setup
OLLAMA_MODEL=llama3.2

# ── ANTHROPIC CLAUDE (Paid fallback) ────────
# Sign up at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── SETTINGS (don't change these) ───────────
CHROMA_DB_PATH=./data/chroma_db
MAX_TOKENS=1024
TOP_K_RESULTS=8
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VITE_API_URL=http://localhost:8000
